# ─────────────────────────────────────────────────────────────
# Aurex India — environment (Vite)
# Copy this file to `.env.local` and fill in real values.
# Only variables prefixed with VITE_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Which data backend the service layer uses: "mock" | "supabase"
# Leave as "mock" to run with zero external services (in-repo catalog).
VITE_DATA_SOURCE=mock

# Supabase (only needed when VITE_DATA_SOURCE=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Support handoff (already known from the current site — confirm)
VITE_WHATSAPP_NUMBER=917814477667

# Production origin — used for canonical URLs, Open Graph and structured data.
VITE_SITE_URL=https://aurexindia.com

# ── Razorpay payments ────────────────────────────────────────
# Public Key ID is safe in the frontend. Get test keys from the Razorpay
# dashboard (rzp_test_...). With ONLY this set, checkout runs in demo/test mode
# (no server order_id, no signature verification — not for real money).
VITE_RAZORPAY_KEY_ID=

# Optional: URL of a server that creates orders + verifies signatures securely
# (e.g. a Supabase Edge Function or your future MERN backend). When set, the
# app uses the secure server flow. The Key SECRET lives there, never here.
# VITE_PAYMENTS_API_URL=

# ── AI support bot ───────────────────────────────────────────
# The bot answers from the local catalog + FAQ out of the box (no key needed).
# To upgrade to a real LLM later, put the key on a SERVER (never VITE_),
# expose an endpoint, and point the bot at it:
# VITE_BOT_API_URL=/api/chat
